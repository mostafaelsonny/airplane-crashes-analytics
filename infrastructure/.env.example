# Database Configuration
POSTGRES_DB=airplane_crashes_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Kafka Configuration
KAFKA_BOOTSTRAP_SERVERS_LOCAL=localhost:29092
KAFKA_BOOTSTRAP_SERVERS_DOCKER=kafka:9092
KAFKA_TOPIC_RAW=crashes.raw
KAFKA_TOPIC_CLEANED=crashes.cleaned
KAFKA_TOPIC_DLQ=crashes.dlq

# Apache NiFi Configuration
NIFI_USERNAME=admin
NIFI_PASSWORD=AdminPassword123!
NIFI_PORT=8443

# Producer Configuration
SIMULATION_INTERVAL_SECONDS=1.5
BATCH_SIZE=50
